// Cloudflare Workers static-assets config (used if the site is deployed as a Worker).
// A Pages project ignores this file. The Worker name must match the dashboard name.
{
  "name": "eigenblade",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public"
  },
  // Custom domains: wrangler deploy attaches these, creating DNS and HTTPS itself.
  "routes": [
    { "pattern": "eigenblade.ninja", "custom_domain": true },
    { "pattern": "www.eigenblade.ninja", "custom_domain": true }
  ]
}
